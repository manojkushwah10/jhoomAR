# Copy to .env.local and fill in. Never commit .env.local.

# ---- Site ----
# Public base URL, no trailing slash. Local: http://localhost:3000. Vercel: https://<project>.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Default WhatsApp number (country code, digits only). Moves to admin Site settings in M3.
NEXT_PUBLIC_WHATSAPP_NUMBER=919999999999
# Experimental WebXR AR mode on Android Chrome. Keep false.
NEXT_PUBLIC_AR_WEBXR_EXPERIMENTAL=false

# ---- Database (PostgreSQL) ----
# Local: postgresql://<mac-user>@localhost:5432/jhoomar_dev
# Neon: the *pooled* connection string (host contains "-pooler")
DATABASE_URL=postgresql://USER@localhost:5432/jhoomar_dev
# Neon only: the direct (non-pooled) connection string, used for migrations. Leave empty locally.
DIRECT_URL=

# ---- Admin auth (Better Auth) ----
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as NEXT_PUBLIC_SITE_URL
BETTER_AUTH_URL=http://localhost:3000

# ---- File storage ----
# "local" = files in ./.storage (development only). "r2" = Cloudflare R2.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public URL of the bucket (custom domain or r2.dev), no trailing slash
R2_PUBLIC_BASE_URL=
